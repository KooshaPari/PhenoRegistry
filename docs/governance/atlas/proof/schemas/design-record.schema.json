{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.4"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "intent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "fixture_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "purpose",
          "fixture_id"
        ]
      },
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from_state": {
            "type": "string",
            "minLength": 1
          },
          "to_state": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "from_state",
          "to_state",
          "action",
          "expected_effect"
        ]
      },
      "minItems": 0
    },
    "editable_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "ascii",
            "svg",
            "figma",
            "penpot",
            "raster",
            "scene",
            "prototype",
            "schema"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ]
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "minItems": 0
    },
    "review_status": {
      "enum": [
        "exploratory",
        "proposed",
        "reviewed",
        "accepted-for-scope",
        "superseded"
      ]
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "subject_id",
    "revision",
    "intent_ids",
    "capability_ids",
    "states",
    "transitions",
    "editable_source",
    "previews",
    "review_status",
    "approval_reference",
    "implementation_evidence_ids",
    "synthetic"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
