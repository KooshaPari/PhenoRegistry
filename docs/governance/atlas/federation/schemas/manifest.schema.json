{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "product_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publisher_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "synthetic": {
      "const": true
    },
    "evidence_status": {
      "const": "ILLUSTRATIVE_NOT_INSTALLED"
    },
    "provided_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "minLength": 2
          },
          "interface_version": {
            "type": "string",
            "minLength": 1
          },
          "semantic_contract": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "minLength": 2
          },
          "schema_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "data_authority": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "minLength": 2
          }
        },
        "required": [
          "id",
          "interface_version",
          "semantic_contract",
          "schema_sha256",
          "operations",
          "data_authority"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "base_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "optional_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "host_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "minLength": 2
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "inspector",
                "task-view",
                "preview",
                "command",
                "search",
                "notification",
                "cli-operation"
              ]
            },
            "uniqueItems": true
          },
          "supported_adapters": {
            "type": "array",
            "items": {
              "enum": [
                "native-extension",
                "host-rendered",
                "isolated-webview",
                "web-module",
                "remote-surface",
                "headless"
              ]
            },
            "uniqueItems": true
          },
          "security_profile": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
            "minLength": 2
          }
        },
        "required": [
          "id",
          "kinds",
          "supported_adapters",
          "security_profile"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "lifecycle_contract": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "resource_profile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "minLength": 2
    },
    "state_authorities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "minLength": 2
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "product_id",
    "package_id",
    "package_version",
    "artifact_sha256",
    "publisher_id",
    "synthetic",
    "evidence_status",
    "provided_capabilities",
    "base_requirements",
    "optional_requirements",
    "host_slots",
    "lifecycle_contract",
    "resource_profile",
    "state_authorities"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phenotype:plan:federation:manifest:1",
  "title": "Illustrative installed-application contract profile"
}
