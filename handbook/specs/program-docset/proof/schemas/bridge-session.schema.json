{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.4"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process_start_identity": {
          "type": "string",
          "minLength": 1
        },
        "window_or_render_target": {
          "type": "string",
          "minLength": 1
        },
        "world_or_workspace": {
          "type": "string",
          "minLength": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "process_start_identity",
        "window_or_render_target",
        "world_or_workspace",
        "nonce"
      ]
    },
    "access_class": {
      "enum": [
        "white-box",
        "gray-box",
        "black-box",
        "mixed"
      ]
    },
    "action_routes": {
      "type": "array",
      "items": {
        "enum": [
          "fixture-control",
          "semantic-command",
          "user-input",
          "accessibility-action",
          "browser-action",
          "read-only"
        ]
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "enum": [
          "semantic-state",
          "pixels",
          "video",
          "audio",
          "metrics",
          "logs",
          "accessibility",
          "saved-state"
        ]
      },
      "minItems": 1
    },
    "scope_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_slots": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_lease": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "wall_seconds",
        "cpu_slots",
        "gpu_lease"
      ]
    },
    "status": {
      "enum": [
        "PLANNED_NOT_EXECUTED",
        "OBSERVED_UNQUALIFIED",
        "QUALIFIED_WITH_EVIDENCE"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "subject_id",
    "source_revision",
    "artifact_sha256",
    "instance",
    "access_class",
    "action_routes",
    "observations",
    "scope_references",
    "limits",
    "status",
    "evidence_ids",
    "synthetic"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
