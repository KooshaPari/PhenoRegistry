{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.phenotype.invalid/pep/1.0.0/outbox.schema.json",
  "title": "outbox",
  "type": "object",
  "properties": {
    "kind": {
      "const": "outbox"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "TEMPLATE",
        "EXAMPLE",
        "OPERATIONAL"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "destination_label": {
      "type": "string",
      "minLength": 1
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PENDING",
        "BLOCKED",
        "DELIVERED"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "record_status",
    "created_at",
    "destination_label",
    "payload_digest",
    "idempotency_key",
    "authority_ref",
    "state",
    "attempt_count",
    "receipt_ref",
    "last_error"
  ],
  "additionalProperties": false
}
