      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "pillar_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "applicability_trigger": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "minLength": 1
    },
    "procedure": {
      "type": "string",
      "minLength": 1
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "positive_control": {
      "type": "string",
      "minLength": 1
    },
    "negative_control": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_rule": {
      "type": "string",
      "minLength": 1
    },
    "invalidators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "activation_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "implementation_status": {
      "type": "string",
      "minLength": 1
    },
    "qualification_status": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "source_context_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "native_standard_requirement_id": {
      "type": [
        "string",
        "null"
      ]
