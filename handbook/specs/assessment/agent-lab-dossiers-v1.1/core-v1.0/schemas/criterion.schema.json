    "schema_version",
    "id",
    "revision",
    "domain_id",
    "pillar_id",
    "predicate",
    "applicability_trigger",
    "modality",
    "procedure",
    "evidence_requirements",
    "positive_control",
    "negative_control",
    "acceptance_rule",
    "invalidators",
    "activation_requirements",
    "implementation_status",
    "qualification_status",
    "origin",
    "source_context_ids",
    "native_standard_requirement_id",
    "proposed_priority",
    "default_gate"
