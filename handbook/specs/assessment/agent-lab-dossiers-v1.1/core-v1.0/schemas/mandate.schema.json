{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.phenotype.invalid/pep/1.0.0/mandate.schema.json",
  "title": "mandate",
  "type": "object",
  "properties": {
    "kind": {
      "const": "mandate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "TEMPLATE",
        "EXAMPLE",
        "OPERATIONAL"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACCEPTED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "reserved_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "resource_envelope": {
      "type": "object",
      "properties": {
        "total_budget_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "consumed_units": {
          "type": "number",
          "minimum": 0
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "total_budget_units",
        "unit",
        "consumed_units",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "host_authority_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "record_status",
    "created_at",
    "parent_ref",
    "issuer_ref",
    "status",
    "scope",
    "allowed_actions",
    "reserved_actions",
    "resource_envelope",
    "host_authority_evidence_refs",
    "stop_conditions"
  ],
  "additionalProperties": false
}
