            "5",
            "6",
            "X",
            "D",
            "R",
            "S"
          ]
        },
        "S": {
          "enum": [
            "U",
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "X",
            "D",
            "R",
            "S"
          ]
        },
        "A": {
          "enum": [
            "U",
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "X",
            "D",
            "R",
            "S"
          ]
