            "6",
            "X",
            "D",
            "R",
            "S"
          ]
        },
        "Q": {
          "enum": [
            "U",
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "X",
            "D",
            "R",
            "S"
          ]
        },
        "E": {
          "enum": [
            "U",
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "X",
            "D",
            "R",
            "S"
          ]
        },
        "O": {
          "enum": [
            "U",
            "0",
            "1",
            "2",
