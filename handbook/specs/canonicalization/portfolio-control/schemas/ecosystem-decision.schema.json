{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phenotype.invalid/schemas/ecosystem-decision.schema.json",
  "title": "Ecosystem Decision",
  "type": "object",
  "required": [
    "id",
    "question",
    "status",
    "scope",
    "alternatives",
    "evidence_required",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEC-[A-Z0-9-]+$"
    },
    "question": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "INVESTIGATING",
        "BLOCKED",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": [
        "object",
        "null"
      ]
    },
    "owner": {
      "type": "string"
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reconsideration_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}