  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Placeholder for the existing trusted identity system; this is not a long-lived-token recommendation."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "correlation_id"
        ]
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "oci_image",
              "binary_bundle",
              "package",
              "site_bundle",
              "provider_git_build"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "digest",
          "source_revision"
        ]
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "workload_id": {
            "type": "string",
            "minLength": 1
          },
          "environment_id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "service",
              "worker",
              "package",
              "desktop",
              "static_site",
              "data_migration"
            ]
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          },
          "configuration_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "policy_revision": {
            "type": "string",
            "minLength": 1
          },
          "secret_version_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "candidate_id",
          "workload_id",
          "environment_id",
          "profile",
          "artifacts",
          "configuration_digest",
          "policy_revision",
          "secret_version_refs"
        ]
      },
      "PlanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/Candidate"
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_generation": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "candidate",
          "target_id",
          "expected_target_generation"
        ]
      },
      "Plan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_generation": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "blocked",
              "ready_for_authorization"
            ]
          }
        },
        "required": [
          "plan_id",
          "plan_digest",
          "candidate_id",
          "target_id",
          "expected_target_generation",
          "expires_at",
          "changes",
          "blockers",
          "status"
        ]
      },
      "AuthorizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_generation": {
            "type": "integer",
            "minimum": 0
          },
          "nonce": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "plan_id",
          "candidate_id",
          "expected_target_generation",
          "nonce"
        ]
      },
      "Authorization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "authorization_id": {
            "type": "string",
            "minLength": 1
          },
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "issuer_principal": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "granted",
              "denied",
              "expired",
              "revoked"
            ]
          }
        },
        "required": [
          "authorization_id",
          "plan_id",
          "candidate_id",
          "issuer_principal",
          "expires_at",
          "status"
        ]
      },
      "ApplyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "authorization_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_generation": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "plan_id",
          "candidate_id",
          "authorization_id",
          "expected_target_generation"
        ]
      },
      "RecoveryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "failed_operation_id": {
            "type": "string",
            "minLength": 1
          },
          "recovery_plan_id": {
            "type": "string",
            "minLength": 1
          },
          "prior_candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "authorization_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_target_generation": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "failed_operation_id",
          "recovery_plan_id",
          "prior_candidate_id",
          "authorization_id",
          "expected_target_generation"
        ]
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "apply",
              "recover"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "queued",
              "preparing",
              "applying",
              "observing",
              "healthy",
              "recovering",
              "recovered",
              "failed",
              "unknown"
            ]
          },
          "observed_target_generation": {
            "type": "integer",
            "minimum": 0
          },
          "receipt_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "operation_id",
          "kind",
          "target_id",
          "candidate_id",
          "state",
          "observed_target_generation",
          "receipt_refs",
          "reason"
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "enum": [
              "healthy",
              "degraded",
              "offline",
              "unknown"
            ]
          },
          "candidate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "target_id",
          "generation",
          "observed_at",
          "state",
          "candidate_id",
          "capability_evidence_refs"
        ]
      }
    }
  }
}
