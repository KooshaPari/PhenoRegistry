    "/v1/authorizations": {
      "post": {
        "operationId": "requestAuthorization",
        "summary": "requestAuthorization",
        "description": "Proposed existing-controller contract. Server validates identity, source evidence, freshness, policy and trusted authority; client flags are not approval.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
