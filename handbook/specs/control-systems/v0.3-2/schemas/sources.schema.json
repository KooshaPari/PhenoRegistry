{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "locator",
          "review_date",
          "claims_supported",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "user_supplied_artifact",
              "connected_repository_document",
              "connected_repository_metadata",
              "retrieved_prior_user_file",
              "primary_external_document",
              "stored_tool_output",
              "connected_repository_file",
              "connected_lookup_result"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "review_date": {
            "type": "string",
            "minLength": 1
          },
          "claims_supported": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phenotype:deployment-review:sources:0.1.0",
  "title": "Review source catalog"
}
