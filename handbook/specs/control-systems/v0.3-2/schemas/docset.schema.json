{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_date",
    "status",
    "sources_file",
    "constraints",
    "findings",
    "requirements",
    "acceptance_tests",
    "decisions",
    "work_items",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "document_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "design_baseline_not_deployment_approval"
    },
    "sources_file": {
      "const": "machine/sources.json"
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "text",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "direct_user_constraint"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "priority",
          "verdict",
          "source_ids",
          "detail",
          "closure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "verdict": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "closure": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "statement",
          "source_ids",
          "finding_ids",
          "acceptance_test_ids",
          "owner_role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "proposed"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_test_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "requirement_ids",
          "procedure",
          "expected",
          "evidence_required",
          "execution_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "not_run"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "procedure": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution_evidence": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "source_ids",
          "decision",
          "alternatives",
          "revisit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "accepted_user_constraint",
              "proposed"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revisit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "depends_on",
          "requirement_ids",
          "priority",
          "status",
          "exit_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "const": "not_started"
          },
          "exit_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_ci_trio",
        "activated_student_pro",
        "repository_owner_plan_matrix",
        "canonical_deployment_module",
        "installed_wsl_version",
        "installed_wslc_version",
        "installed_podman_version",
        "production_approval_identity",
        "monthly_cost_ceiling_for_this_stack",
        "availability_rto_rpo_targets"
      ],
      "properties": {
        "exact_ci_trio": {
          "type": "null"
        },
        "activated_student_pro": {
          "type": "null"
        },
        "repository_owner_plan_matrix": {
          "type": "null"
        },
        "canonical_deployment_module": {
          "type": "null"
        },
        "installed_wsl_version": {
          "type": "null"
        },
        "installed_wslc_version": {
          "type": "null"
        },
        "installed_podman_version": {
          "type": "null"
        },
        "production_approval_identity": {
          "type": "null"
        },
        "monthly_cost_ceiling_for_this_stack": {
          "type": "null"
        },
        "availability_rto_rpo_targets": {
          "type": "null"
        },
        "exact_ci_trio_note": {
          "type": "string"
        },
        "original_full_transcript": {
          "type": "string"
        },
        "local_node_daemon_canonical_owner": {
          "type": "null"
        },
        "desktop_resource_reserve_profile": {
          "type": "null"
        },
        "laptop_resource_reserve_profile": {
          "type": "null"
        },
        "current_reviewer_quota_snapshot": {
          "type": "null"
        },
        "macroscope_credit_remaining": {
          "type": "null"
        },
        "emergent_garden_integration_target": {
          "type": "null"
        },
        "review_backlog_total_unresolved_material_findings": {
          "type": "null"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phenotype:deployment-review:docset:0.1.0",
  "title": "Deployment review baseline \u2014 not runtime or deployment authorization"
}
