{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_only",
    "production_eligible",
    "subject_id",
    "subject_kind",
    "runtime_kind",
    "observed_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "example_only": {
      "const": true
    },
    "production_eligible": {
      "const": false
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_kind": {
      "enum": [
        "runtime_candidate",
        "target_candidate",
        "network_path_candidate"
      ]
    },
    "runtime_kind": {
      "enum": [
        "podman_wsl2",
        "wslc",
        "docker_engine",
        "other"
      ]
    },
    "observed_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "runtime",
              "host",
              "network_path"
            ]
          },
          "result": {
            "enum": [
              "supported_with_evidence",
              "unsupported_with_evidence",
              "unqualified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phenotype:deployment-review:capability-example:0.1.0",
  "title": "Non-production capability-profile example"
}
